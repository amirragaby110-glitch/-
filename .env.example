# ===== تنظیمات AI (اختیاری) =====
# با این کلید، چت هوش مصنوعی از Groq (Llama 3.3 70B) استفاده می‌کند.
# بدون آن، موتور محلی «نکسوس RAG» (کاملاً آفلاین) پاسخ می‌دهد.
GROQ_API_KEY=
# Groq model override (اختیاری)
GROQ_MODEL=llama-3.3-70b-versatile

# ===== جایگزین: Hugging Face Inference (رایگان) =====
# اگر GROQ_API_KEY نباشد و این باشد، از HF استفاده می‌شود
HUGGINGFACE_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_API_URL=https://router.huggingface.co/v1/chat/completions
